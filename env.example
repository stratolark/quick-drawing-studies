# Template for the coach backend's environment. Copy to .env and fill in; .env is git-ignored.
# (Named env.example because this repository's tooling blocked creating .env.example directly.)
# Never put these values in client code.

# Which coach backend to use: anthropic, mock or off.
# Defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise off.
QS_COACH_PROVIDER=mock

# Claude API key (server only). Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Model and effort for coach reviews.
QS_MODEL=claude-opus-5-5
QS_EFFORT=medium
# Server-side refusal fallback (on by default). Set to off to disable.
QS_FALLBACKS=on

# Where the backend listens. Keep 127.0.0.1 for local use.
# Any other host with the anthropic provider requires QS_ACCESS_TOKEN.
QS_SERVER_HOST=127.0.0.1
QS_SERVER_PORT=8787

# Shared access code learners enter in the app's coach settings. Required when the server is reachable from other machines.
QS_ACCESS_TOKEN=

# Abuse and cost limits.
QS_RATE_PER_MINUTE=6
QS_RATE_PER_DAY=100
QS_DAILY_BUDGET_USD=2
QS_TIMEOUT_MS=60000

# Mock failure simulation: ok, slow, timeout, malformed, hallucinate, refuse, error.
QS_MOCK_MODE=ok
